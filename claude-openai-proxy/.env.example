# ===========================================================================
# claude-openai-proxy 환경설정 예시
# 이 파일을 `.env` 로 복사하여 사용하세요.
#
# ※ Anthropic API Key 는 저장하지 않습니다.
#    인증은 Claude Code CLI 의 OAuth 로그인(`claude login`)을 재사용합니다.
# ===========================================================================

# 서버 바인딩
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 프록시 접근 토큰 (선택)
# - Anthropic 키가 아니라 이 프록시에 접근하기 위한 자체 토큰입니다.
# - 값을 넣으면 클라이언트는 `Authorization: Bearer <값>` 을 보내야 합니다.
# - 비워두면 인증 없이 누구나 호출할 수 있습니다(내부 신뢰 네트워크 전용).
PROXY_API_KEY=

# 단일 요청 처리 타임아웃(초)
REQUEST_TIMEOUT=300
